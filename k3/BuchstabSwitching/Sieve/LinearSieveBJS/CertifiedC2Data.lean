/-! #### Fast `tauUB` Evaluator and `C2_bjs` Verification (`≤ 494`) -/

def aCoef2 : ℕ := 982521028
def bCoef2 : ℕ := 2442805600
def aCoef22 : ℕ := 980175248
def bCoef22 : ℕ := 2983649600
def aCoef24 : ℕ := 973378190
def bCoef24 : ℕ := 3644237976
def aCoef26 : ℕ := 957616413
def bCoef26 : ℕ := 4451082467
def aCoef28 : ℕ := 927496819
def bCoef28 : ℕ := 5436563658
def aCoef3 : ℕ := 879492758
def bCoef3 : ℕ := 7248751543
def aCoefT : ℕ := 971800000
def bCoefT : ℕ := 6060000000
def cCoef2 : ℕ := 4020000000
def bCoefPrime : ℕ := 7248751543
def jUbNum : ℕ := 988342251

def xiUB (aC bC prev a b : ℕ) : ℕ :=
  ceilDiv (prev * aC) scaleT + ceilDiv (bC * a) scaleT + 2 * b

def xiTildeUB (prev a b : ℕ) : ℕ :=
  ceilDiv (prev * aCoefT) scaleT + ceilDiv (bCoefT * a) scaleT + ceilDiv (cCoef2 * b) scaleT

def tauStepVal (n tau a b : ℕ) : ℕ :=
  if n % 2 = 0 then
    max (xiUB aCoef2 bCoef2 tau a b)
      (max (xiUB aCoef22 bCoef22 tau a b)
        (max (xiUB aCoef24 bCoef24 tau a b)
          (max (xiUB aCoef26 bCoef26 tau a b)
            (max (xiUB aCoef28 bCoef28 tau a b)
              (xiUB aCoef3 bCoef3 tau a b)))))
  else
    max (xiUB aCoef3 bCoef3 tau a b) (xiTildeUB tau a b)

def taupStepVal (taup a b : ℕ) : ℕ :=
  ceilDiv (taup * aCoef2) scaleT + ceilDiv (bCoefPrime * a) scaleT +
    ceilDiv (cCoef2 * b) scaleT

def tauStepCheck (n tauPrev taupPrev aPrev t tp b : ℕ) : Bool :=
  (if n ≤ 10 then decide (scaleT * cNum n ^ (n - 1) ≤ b * 10000 ^ (n - 1))
   else if cNum n = cNum (n - 1) then decide (ceilDiv (aPrev * cNum n) 10000 ≤ b)
   else decide (scaleT * cNum n ^ (n - 1) ≤ b * 10000 ^ (n - 1))) &&
    decide (tauStepVal n tauPrev aPrev b ≤ t) &&
    decide (taupStepVal taupPrev aPrev b ≤ tp)

def checkTauList : ℕ → ℕ → ℕ → ℕ → List (ℕ × ℕ × ℕ) → Bool
  | _, _, _, _, [] => true
  | n, tP, tpP, aP, (t, tp, b) :: rest =>
    tauStepCheck n tP tpP aP t tp b && checkTauList (n + 1) t tp b rest

def checkTauList4 : ℕ → ℕ → ℕ → ℕ → List (ℕ × ℕ × ℕ) → Bool
  | _, _, _, _, [] => true
  | n, tP, tpP, aP, (t1, tp1, b1) :: (t2, tp2, b2) :: (t3, tp3, b3) :: (t4, tp4, b4) :: rest =>
    tauStepCheck n tP tpP aP t1 tp1 b1 && tauStepCheck (n + 1) t1 tp1 b1 t2 tp2 b2 &&
      tauStepCheck (n + 2) t2 tp2 b2 t3 tp3 b3 && tauStepCheck (n + 3) t3 tp3 b3 t4 tp4 b4 &&
      checkTauList4 (n + 4) t4 tp4 b4 rest
  | n, tP, tpP, aP, (t, tp, b) :: rest =>
    tauStepCheck n tP tpP aP t tp b && checkTauList4 (n + 1) t tp b rest

lemma checkTauList4_eq (n tP tpP aP : ℕ) (xs : List (ℕ × ℕ × ℕ)) :
    checkTauList4 n tP tpP aP xs = checkTauList n tP tpP aP xs := by
  match xs with
  | [] => rfl
  | [(_, _, _)] => rfl
  | [(_, _, _), (_, _, _)] => rfl
  | [(_, _, _), (_, _, _), (_, _, _)] => rfl
  | (_, _, _) :: (_, _, _) :: (_, _, _) :: (t4, tp4, b4) :: rest =>
    have ih := checkTauList4_eq (n + 4) t4 tp4 b4 rest
    dsimp only [checkTauList4]
    rw [ih]
    dsimp only [checkTauList]
    simp only [Bool.and_assoc]

def sumEvenTau : ℕ → List (ℕ × ℕ × ℕ) → ℕ
  | _, [] => 0
  | n, (t, _, _) :: rest => (if n % 2 = 0 ∧ n ≤ 2 * keTail then t else 0) + sumEvenTau (n + 1) rest

def sumEvenTau4 : ℕ → List (ℕ × ℕ × ℕ) → ℕ
  | _, [] => 0
  | n, (t1, _, _) :: (t2, _, _) :: (t3, _, _) :: (t4, _, _) :: rest =>
    (if n % 2 = 0 ∧ n ≤ 2 * keTail then t1 else 0) +
      (if (n + 1) % 2 = 0 ∧ n + 1 ≤ 2 * keTail then t2 else 0) +
      (if (n + 2) % 2 = 0 ∧ n + 2 ≤ 2 * keTail then t3 else 0) +
      (if (n + 3) % 2 = 0 ∧ n + 3 ≤ 2 * keTail then t4 else 0) +
      sumEvenTau4 (n + 4) rest
  | n, (t, _, _) :: rest =>
    (if n % 2 = 0 ∧ n ≤ 2 * keTail then t else 0) + sumEvenTau4 (n + 1) rest

lemma sumEvenTau4_eq (n : ℕ) (xs : List (ℕ × ℕ × ℕ)) :
    sumEvenTau4 n xs = sumEvenTau n xs := by
  match xs with
  | [] => rfl
  | [(_, _, _)] => rfl
  | [(_, _, _), (_, _, _)] => rfl
  | [(_, _, _), (_, _, _), (_, _, _)] => rfl
  | (_, _, _) :: (_, _, _) :: (_, _, _) :: (_, _, _) :: rest =>
    have ih := sumEvenTau4_eq (n + 4) rest
    dsimp only [sumEvenTau4]
    rw [ih]
    dsimp only [sumEvenTau]
    simp only [Nat.add_assoc]

