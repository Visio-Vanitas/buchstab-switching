import Mathlib.Tactic.Ring
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.IntervalCases

namespace BuchstabSwitching

/-! ### Certified Numerical Data and Kernel Evaluators for `C2_bjs` -/

section CertifiedC2Data

def scaleF : ℕ := 10 ^ 12
def gridG : ℕ := 16
def expStepNum : ℕ := 1064494458947

def scaleT : ℕ := 10 ^ 9
def keTail : ℕ := 150

def ceilDiv (a b : ℕ) : ℕ := (a + b - 1) / b

def listGetD (xs : List ℕ) (i d : ℕ) : ℕ :=
  match xs, i with
  | [], _ => d
  | x :: _, 0 => x
  | _ :: xs, i + 1 => listGetD xs i d

/-! #### `R` Table Builder (`1 / (2 * e^2 * h_bjs s)`) -/

def pwStep (x : ℕ) : ℕ := ceilDiv (x * expStepNum) scaleF

def pwVal : ℕ → ℕ
  | 0 => scaleF
  | k + 1 => pwStep (pwVal k)

def rVal (j : ℕ) : ℕ :=
  if j ≤ gridG then scaleF / 2
  else if j ≤ 2 * gridG then ceilDiv (pwVal (j - gridG)) 2
  else ceilDiv (pwVal (j - gridG) * (gridG + j)) (6 * gridG)

def buildPwListAux : ℕ → ℕ → List ℕ
  | 0, _ => []
  | m + 1, k => pwVal (k + 1) :: buildPwListAux m (k + 1)

def buildPwFast : ℕ → ℕ → List ℕ
  | 0, _ => []
  | m + 1, cur =>
    let nxt := pwStep cur
    nxt :: buildPwFast m nxt

def uNextR : ℕ → List ℕ → List ℕ
  | _, [] => []
  | j, pw :: pws =>
    (if j ≤ 2 * gridG then ceilDiv pw 2 else ceilDiv (pw * (gridG + j)) (6 * gridG)) ::
      uNextR (j + 1) pws

def buildRList (jmax : ℕ) : List ℕ :=
  List.replicate (gridG + 1) (scaleF / 2) ++
    uNextR (gridG + 1) (buildPwFast (jmax - gridG) scaleF)

/-! #### `U_n` and `M_n` Grid Evaluators (`n = 1..10`) with Materialized Checkpoints -/

def suffixSums : List ℕ → List ℕ
  | [] => []
  | x :: xs =>
    let rest := suffixSums xs
    (x + rest.headD 0) :: rest

def suffixSums4 : List ℕ → List ℕ
  | x1 :: x2 :: x3 :: x4 :: xs =>
    let rest := suffixSums4 xs
    let s4 := x4 + rest.headD 0
    let s3 := x3 + s4
    let s2 := x2 + s3
    let s1 := x1 + s2
    s1 :: s2 :: s3 :: s4 :: rest
  | [x1, x2, x3] => [x1 + x2 + x3, x2 + x3, x3]
  | [x1, x2] => [x1 + x2, x2]
  | [x1] => [x1]
  | [] => []

lemma suffixSums4_eq (xs : List ℕ) : suffixSums4 xs = suffixSums xs := by
  match xs with
  | [] => rfl
  | [_] => rfl
  | [_, _] => rfl
  | [x1, x2, x3] =>
    dsimp only [suffixSums4, suffixSums]
    rw [List.headD_nil, List.headD_cons, List.headD_cons]
    simp only [Nat.add_zero, Nat.add_assoc]
  | x1 :: x2 :: x3 :: x4 :: xs =>
    have ih := suffixSums4_eq xs
    dsimp only [suffixSums4]
    rw [ih]
    dsimp only [suffixSums]
    rw [List.headD_cons, List.headD_cons, List.headD_cons]

def uInit : List ℕ :=
  (List.range (2 * gridG + 1)).map (fun i => ceilDiv (scaleF * (2 * gridG - i)) (gridG + i))

def uNextEvenAux : ℕ → List ℕ → List ℕ
  | _, [] => []
  | k, s :: ss => ceilDiv s k :: uNextEvenAux (k + 1) ss

def uNextEvenAux4 : ℕ → List ℕ → List ℕ
  | k, s1 :: s2 :: s3 :: s4 :: ss =>
    ceilDiv s1 k :: ceilDiv s2 (k + 1) :: ceilDiv s3 (k + 2) :: ceilDiv s4 (k + 3) ::
      uNextEvenAux4 (k + 4) ss
  | k, [s1, s2, s3] => [ceilDiv s1 k, ceilDiv s2 (k + 1), ceilDiv s3 (k + 2)]
  | k, [s1, s2] => [ceilDiv s1 k, ceilDiv s2 (k + 1)]
  | k, [s1] => [ceilDiv s1 k]
  | _, [] => []

lemma uNextEvenAux4_eq (k : ℕ) (xs : List ℕ) : uNextEvenAux4 k xs = uNextEvenAux k xs := by
  match xs with
  | [] => rfl
  | [_] => rfl
  | [_, _] => rfl
  | [_, _, _] => rfl
  | s1 :: s2 :: s3 :: s4 :: ss =>
    have ih := uNextEvenAux4_eq (k + 4) ss
    dsimp only [uNextEvenAux4, uNextEvenAux]
    rw [ih]

def uNext (nNext : ℕ) (uPrev : List ℕ) : List ℕ :=
  let suf := suffixSums4 uPrev
  if nNext % 2 = 0 then uNextEvenAux4 (2 * gridG) suf
  else
    (List.range (2 * gridG)).map (fun i => ceilDiv (suf.headD 0) (gridG + i)) ++
      uNextEvenAux4 (3 * gridG) suf

def zipMaxScaled : List ℕ → List ℕ → ℕ
  | [], _ => 0
  | _, [] => 0
  | u :: us, r :: rs => max (ceilDiv (u * r) scaleF) (zipMaxScaled us rs)

def max2 (a b : ℕ) : ℕ := if a ≤ b then b else a

lemma max2_eq (a b : ℕ) : max2 a b = max a b := by
  dsimp only [max2]; rw [Nat.max_def]

def zipMaxScaled4 : List ℕ → List ℕ → ℕ
  | [], _ => 0
  | _, [] => 0
  | u1 :: u2 :: u3 :: u4 :: us, r1 :: r2 :: r3 :: r4 :: rs =>
    let a1 := ceilDiv (u1 * r1) scaleF
    let a2 := ceilDiv (u2 * r2) scaleF
    let a3 := ceilDiv (u3 * r3) scaleF
    let a4 := ceilDiv (u4 * r4) scaleF
    max2 (max2 (max2 a1 a2) (max2 a3 a4)) (zipMaxScaled4 us rs)
  | u :: us, r :: rs => max2 (ceilDiv (u * r) scaleF) (zipMaxScaled4 us rs)

lemma zipMaxScaled4_eq (us rs : List ℕ) : zipMaxScaled4 us rs = zipMaxScaled us rs := by
  rcases us with _ | ⟨u1, _ | ⟨u2, _ | ⟨u3, _ | ⟨u4, us'⟩⟩⟩⟩ <;>
  rcases rs with _ | ⟨r1, _ | ⟨r2, _ | ⟨r3, _ | ⟨r4, rs'⟩⟩⟩⟩
  · rfl
  · rfl
  · rfl
  · rfl
  · rfl
  all_goals
    try rfl
  all_goals
    dsimp only [zipMaxScaled4, zipMaxScaled]
    simp only [max2_eq, Nat.max_assoc]
    first
    | rw [zipMaxScaled4_eq us' rs']
    | (rw [zipMaxScaled4_eq]; dsimp only [zipMaxScaled])
termination_by us.length

def listLen4 {α : Type} : List α → ℕ
  | _ :: _ :: _ :: _ :: xs => 4 + listLen4 xs
  | _ :: xs => 1 + listLen4 xs
  | [] => 0

lemma listLen4_eq {α : Type} (xs : List α) : listLen4 xs = xs.length := by
  match xs with
  | [] => rfl
  | [_] => rfl
  | [_, _] => rfl
  | [_, _, _] => rfl
  | _ :: _ :: _ :: _ :: xs =>
    have ih := listLen4_eq xs
    dsimp only [listLen4]
    rw [ih, List.length_cons, List.length_cons, List.length_cons, List.length_cons]
    omega

def aBase (n : ℕ) : ℕ := if n % 2 = 0 then 2 else 1

def uListSeq : ℕ → List ℕ
  | 0 => []
  | 1 => uInit
  | n + 2 => uNext (n + 2) (uListSeq (n + 1))

lemma uNext_eq (nNext : ℕ) (uPrev : List ℕ) :
    uNext nNext uPrev =
      let suf := suffixSums uPrev
      if nNext % 2 = 0 then uNextEvenAux (2 * gridG) suf
      else
        (List.range (2 * gridG)).map (fun i => ceilDiv (suf.headD 0) (gridG + i)) ++
          uNextEvenAux (3 * gridG) suf := by
  simp only [uNext, suffixSums4_eq, uNextEvenAux4_eq]

def mCertGo (rList : List ℕ) : ℕ → ℕ → List ℕ → List ℕ
  | 0, _, _ => []
  | rem + 1, nCur, uCur =>
    let nNext := nCur + 1
    let uNextL := uNext nNext uCur
    let off := if nNext % 2 = 0 then gridG + 1 else 1
    let mVal := zipMaxScaled uNextL (rList.drop off)
    mVal :: mCertGo rList rem nNext uNextL

def mCertList : List ℕ :=
  mCertGo (buildRList (gridG * 12)) 9 1 uInit

