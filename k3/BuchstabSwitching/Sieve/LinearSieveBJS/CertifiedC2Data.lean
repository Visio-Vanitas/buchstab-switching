/-! #### Concrete `cNum` Sequence (`N0 = 10`) and Fast Binary Checks -/

def cNumsPrefix : List ℕ :=
  [3620, 4080, 4810, 5330, 5630, 5930, 6080, 6280, 6360]

def cNum (n : ℕ) : ℕ :=
  if n ≤ 1 then 9607
  else if n ≤ 10 then listGetD cNumsPrefix (n - 2) 9607
  else if n ≤ 15 then 7400
  else if n ≤ 20 then 7900
  else if n ≤ 30 then 8400
  else if n ≤ 60 then 8900
  else if n ≤ 150 then 9200
  else if n ≤ 305 then 9350
  else 9607

lemma cNum_bounds (n : ℕ) : 0 < cNum n ∧ cNum n ≤ 9607 := by
  unfold cNum
  split_ifs with h1 h2 h3 h4 h5 h6 h7 h8
  · norm_num
  · have : n - 2 < 9 := by omega
    interval_cases (n - 2) <;> simp [cNumsPrefix, listGetD]
  all_goals norm_num

def tailNum : ℕ → ℕ
  | 0 => mCertVal 10
  | k + 1 => ceilDiv (tailNum k * (if (k + 11) % 2 = 0 then 9607 else 9214)) 10000

lemma mCertVal_prefix_check :
    (List.range 9).all (fun k =>
      decide (mCertVal (k + 2) * 10000 ^ (k + 1) ≤ scaleF * (cNum (k + 2)) ^ (k + 1))) = true := by
  simp only [mCertVal, mCertList_eq]
  decide

lemma mCertVal_10_le_pow9 :
    mCertVal 10 * 10000 ^ 9 ≤ scaleF * 9607 ^ 9 := by
  simp only [mCertVal, mCertList_eq]
  decide

def tailStepCheck (n prevT prevP t p : ℕ) : Bool :=
  decide (ceilDiv (prevT * (if n % 2 = 0 then 9607 else 9214)) 10000 ≤ t) &&
    decide (t ≤ p) &&
    (if cNum n = cNum (n - 1) then decide (p ≤ (prevP * cNum n) / 10000)
     else decide (p * 10000 ^ (n - 1) ≤ scaleF * cNum n ^ (n - 1)))

def checkTailList : ℕ → ℕ → ℕ → List (ℕ × ℕ) → Bool
  | _, _, _, [] => true
  | n, prevT, prevP, (t, p) :: xs =>
    tailStepCheck n prevT prevP t p && checkTailList (n + 1) t p xs

def checkTailList4 : ℕ → ℕ → ℕ → List (ℕ × ℕ) → Bool
  | _, _, _, [] => true
  | n, prevT, prevP, (t1, p1) :: (t2, p2) :: (t3, p3) :: (t4, p4) :: xs =>
    tailStepCheck n prevT prevP t1 p1 && tailStepCheck (n + 1) t1 p1 t2 p2 &&
      tailStepCheck (n + 2) t2 p2 t3 p3 && tailStepCheck (n + 3) t3 p3 t4 p4 &&
      checkTailList4 (n + 4) t4 p4 xs
  | n, prevT, prevP, (t, p) :: xs =>
    tailStepCheck n prevT prevP t p && checkTailList4 (n + 1) t p xs

lemma checkTailList4_eq (n prevT prevP : ℕ) (xs : List (ℕ × ℕ)) :
    checkTailList4 n prevT prevP xs = checkTailList n prevT prevP xs := by
  match xs with
  | [] => rfl
  | [(_, _)] => rfl
  | [(_, _), (_, _)] => rfl
  | [(_, _), (_, _), (_, _)] => rfl
  | (_, _) :: (_, _) :: (_, _) :: (t4, p4) :: xs =>
    have ih := checkTailList4_eq (n + 4) t4 p4 xs
    dsimp only [checkTailList4]
    rw [ih]
    dsimp only [checkTailList]
    simp only [Bool.and_assoc]

